{
  "name": "@dsh-external/dsh-remote-access",
  "description": "DSH 鉴权辅助插件：页面密码锁 + 前端 BCrypt 哈希生成器 + 跨平台 Caddy 反向代理配置生成器 + 安全风险审计面板（纯字符串输出，不写文件、不启动程序）",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-base": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "bcryptjs": "^3.0.3",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown --config ./tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/smoke.mjs && node tests/client-load.mjs && node tests/unit.mjs && node tests/boundary.mjs && node tests/scenario.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:boundary": "node tests/boundary.mjs",
    "test:scenario": "node tests/scenario.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:client": "node tests/client-load.mjs"
  },
  "license": "MIT"
}
